# Copier ce fichier en .env.docker puis remplir APP_KEY et les mots de passe.
# Générer une clé : php artisan key:generate --show

APP_NAME="Maquis Express"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Base de données (lue par Laravel ET par le conteneur MySQL) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=maquis
DB_USERNAME=maquis
DB_PASSWORD=change-moi

MYSQL_DATABASE=maquis
MYSQL_USER=maquis
MYSQL_PASSWORD=change-moi
MYSQL_ROOT_PASSWORD=change-moi-aussi

# --- Redis : cache, sessions, files d'attente ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=480
QUEUE_CONNECTION=redis

FILESYSTEM_DISK=public
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Abonnements : où les maquis paient Maquis Express (affiché au patron)
PLATFORM_WAVE_NUMBER=
PLATFORM_ORANGE_NUMBER=
PLATFORM_MTN_NUMBER=
PLATFORM_MOOV_NUMBER=
PLATFORM_WHATSAPP_NUMBER=

# API WhatsApp Business (Meta) : rapport du soir automatique (voir README)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_REPORT_TEMPLATE=rapport_caisse
WHATSAPP_REMINDER_TEMPLATE=rappel_abonnement
WHATSAPP_TEMPLATE_LANGUAGE=fr

# Éditeur : affiché dans les conditions et la politique de confidentialité
PLATFORM_LEGAL_NAME=
PLATFORM_LEGAL_FORM=
PLATFORM_LEGAL_RCCM=
PLATFORM_LEGAL_ADDRESS=
PLATFORM_LEGAL_EMAIL=
PLATFORM_LEGAL_PHONE=
PLATFORM_LEGAL_HOST=
PLATFORM_ARTCI_REFERENCE=

# Alerte à chaque nouvelle demande de démo (e-mail et/ou WhatsApp du Super Admin)
PLATFORM_ALERT_EMAIL=
PLATFORM_ALERT_WHATSAPP=
WHATSAPP_DEMO_TEMPLATE=nouvelle_demande
