# Copier ce fichier en .env.docker puis remplir APP_KEY et les mots de passe.
# Générer une clé : php artisan key:generate --show

APP_NAME="Maquis Express"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Base de données (lue par Laravel ET par le conteneur MySQL) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=maquis
DB_USERNAME=maquis
DB_PASSWORD=change-moi

MYSQL_DATABASE=maquis
MYSQL_USER=maquis
MYSQL_PASSWORD=change-moi
MYSQL_ROOT_PASSWORD=change-moi-aussi

# --- Redis : cache, sessions, files d'attente ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=480
QUEUE_CONNECTION=redis

FILESYSTEM_DISK=public
BROADCAST_CONNECTION=log
MAIL_MAILER=log
